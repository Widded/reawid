# ReaWid - Apple Minimalist OCR & AI Reader
# Environment Configuration Template

# Varsayılan OCR Sağlayıcısı ('auto', 'openrouter' veya 'groq')
EXPO_PUBLIC_OCR_PROVIDER=auto
VITE_OCR_PROVIDER=auto

# OpenRouter API Key (https://openrouter.ai/keys)
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key (https://console.groq.com/keys)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

# Varsayılan Modeller ('auto' = dinamik yük dengeleme ve otomatik yedekleme)
VITE_GROQ_MODEL=auto
VITE_OPENROUTER_MODEL=auto
