# REAWID Environment Variables Template
# Copy this file to .env and provide your own API keys.
# NEVER commit .env to version control!

# Default OCR Provider ('auto', 'openrouter', or 'groq')
VITE_OCR_PROVIDER=auto

# OpenRouter API Key (Get free key at https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=

# Groq API Key (Get free key at https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# Default Models ('auto' = automatic load balancing and fallback)
VITE_GROQ_MODEL=auto
VITE_OPENROUTER_MODEL=auto

# Optional Supabase Cloud Sync
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
